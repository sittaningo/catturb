@article{Case.2015, 
year = {2015}, 
keywords = {death of despair,mortality,mortality and education,cause of death}, 
title = {{Rising morbidity and mortality in midlife among white non-Hispanic Americans in the 21st century}}, 
author = {Case, Anne and Deaton, Angus}, 
journal = {Proceedings of the National Academy of Sciences}, 
issn = {0027-8424}, 
doi = {10.1073/pnas.1518393112}, 
pmid = {26575631}, 
pmcid = {PMC4679063}, 
abstract = {{This paper documents a marked increase in the all-cause mortality of middle-aged white non-Hispanic men and women in the United States between 1999 and 2013. This change reversed decades of progress in mortality and was unique to the United States; no other rich country saw a similar turnaround. The midlife mortality reversal was confined to white non-Hispanics; black non-Hispanics and Hispanics at midlife, and those aged 65 and above in every racial and ethnic group, continued to see mortality rates fall. This increase for whites was largely accounted for by increasing death rates from drug and alcohol poisonings, suicide, and chronic liver diseases and cirrhosis. Although all education groups saw increases in mortality from suicide and poisonings, and an overall increase in external cause mortality, those with less education saw the most marked increases. Rising midlife mortality rates of white non-Hispanics were paralleled by increases in midlife morbidity. Self-reported declines in health, mental health, and ability to conduct activities of daily living, and increases in chronic pain and inability to work, as well as clinically measured deteriorations in liver function, all point to growing distress in this population. We comment on potential economic causes and consequences of this deterioration.}}, 
pages = {15078--15083}, 
number = {49}, 
volume = {112}, 
note = {本稿では、1999年から2013年にかけて米国における非ヒスパニック系白人の中年男女の全死因死亡率が著しく上昇した事実を報告する。この変化は、数十年にわたって続いてきた死亡率改善の傾向を逆転させるものであり、米国特有の現象である。他の豊かな国々で同様の転換は見られない。 
この中年の死亡率上昇は非ヒスパニック系白人に限定された現象であり、同年代の非ヒスパニック系黒人やヒスパニック系の人々、またすべての民族・人種グループにおける65歳以上の人々については、死亡率は低下し続けている。

白人の死亡率上昇の主な要因は、薬物やアルコールの過剰摂取、自殺、慢性肝疾患および肝硬変による死亡率の増加であった。あらゆる学歴層において自殺や中毒による死亡率、および外因死の全体的な増加が見られたものの、低学歴層においてその傾向が最も顕著であった。

非ヒスパニック系白人の中年層における死亡率の上昇と並行して、同層における罹患率も増加している。健康状態や精神的健康状態、日常生活動作能力の低下を訴える声が増え、慢性的な痛みや労働不能状態、さらには臨床的に測定された肝機能の悪化といった事実は、この集団における苦境が深刻化していることを示唆している。最後に、この悪化の背景にある経済的な要因と、それがもたらす結果について考察する。}, 
local-url = {file://localhost/Users/shingo_nitta/Zotero/paper/Case_2015_Rising%20morbidity%20and%20mortality%20in%20midlife%20among%20white%20non-Hispanic%20Americans%20in%20the%2021st%20century_Proceedings%20of%20the%20National%20Academy%20of%20Sciences.pdf}
}
@article{Goldin.2014hl3, 
year = {2014}, 
title = {{A Grand Gender Convergence: Its Last Chapter}}, 
author = {Goldin, Claudia}, 
journal = {American Economic Review}, 
issn = {0002-8282}, 
doi = {10.1257/aer.104.4.1091}, 
abstract = {{The converging roles of men and women are among the grandest advances in society and the economy in the last century. These aspects of the grand gender convergence are figurative chapters in a history of gender roles. But what must the “last” chapter contain for there to be equality in the labor market? The answer may come as a surprise. The solution does not (necessarily) have to involve government intervention and it need not make men more responsible in the home (although that wouldn't hurt). But it must involve changes in the labor market, especially how jobs are structured and remunerated to enhance temporal flexibility. The gender gap in pay would be considerably reduced and might vanish altogether if firms did not have an incentive to disproportionately reward individuals who labored long hours and worked particular hours. Such change has taken off in various sectors, such as technology, science, and health, but is less apparent in the corporate, financial, and legal worlds. (JEL J3, J16, J22, J24, J31, J33, N3)}}, 
pages = {1091--1119}, 
number = {4}, 
volume = {104}, 
note = {本研究は、経済学者のクラウディア・ゴールディン氏による**「大いなるジェンダーの収束：その最終章」**というタイトルの論文からの抜粋です。この論文は、アメリカ経済学会が発行する**「アメリカ経済レビュー」**という学術誌に掲載されました。内容は、過去一世紀にわたる男性と女性の**経済的役割の収束**について論じています。特に、労働市場における完全な平等を実現するための**「最終章」**がどのようなものであるかに焦点を当てています。政府の介入や家庭内での男性の責任増加だけでなく、**労働市場の構造、特に時間的柔軟性を高めるための賃金体系の変更**が重要であると主張しています。さらに、MBAやJDといった**高収入職種における男女間の賃金格差と労働時間の関係**を詳細に分析し、薬学のような**柔軟性の高い職業**との対比を示しています。}, 
keywords = {}, 
local-url = {file://localhost/Users/shingo_nitta/Zotero/paper/Goldin_2014_A%20Grand%20Gender%20Convergence-%20Its%20Last%20Chapter_American%20Economic%20Review.pdf}
}
@article{Monk.2022, 
year = {2022}, 
keywords = {inequality form,inequality,social category,intersectionality,age category}, 
title = {{Inequality without Groups: Contemporary Theories of Categories, Intersectional Typicality, and the Disaggregation of Difference}}, 
author = {Monk, Ellis P.}, 
journal = {Sociological Theory}, 
issn = {0735-2751}, 
doi = {10.1177/07352751221076863}, 
abstract = {{The study of social inequality and stratification (e.g., ethnoracial and gender) has long been at the core of sociology and the social sciences. In this article, I argue that certain tendencies have become entrenched in our dominant paradigm that leave many researchers pursuing coarse-grained analyses of how difference relates to inequality. Centrally, despite the importance of categories and categorization for how researchers study social inequality, contemporary (as opposed to classical) theories of categories are poorly integrated into conventional research. I contend that the widespread and often unquestioned use of state categories as categories of analysis reinforces these tendencies. Using research on colorism as an inspiration, I highlight several components of what I call the infracategorical model of inequality, which urges researchers to disaggregate difference by shifting our focus from membership in (nominal) categories to the cues of categories, membership in subcategories, and perceived typicality.}}, 
pages = {3--27}, 
number = {1}, 
volume = {40}, 
note = {----Title---- グループなき不平等: 現代のカテゴリー理論、交差的典型性、そして差異の分断

----Abstract----
社会的不平等や階層化（エスノレイシャルやジェンダーなど）の研究は、長い間、社会学や社会科学の中核をなしてきた。この論文では、ある種の傾向が我々の支配的なパラダイムに定着してしまい、多くの研究者が差異がどのように不平等に関係するのかについて粗い粒度の分析を追求したままになっていることを論じている。 中心的には、研究者が社会的不平等を研究する方法にとってカテゴリーとカテゴリー化が重要であるにもかかわらず、現代の（古典的とは対照的な）カテゴリーの理論は、従来の研究にうまく統合されていないことである。私は、国家カテゴリーを分析のカテゴリーとして広く、そしてしばしば疑うことなく使用していることが、こうした傾向を強めていると主張する。このモデルは、（名目的な）カテゴリーのメンバーシップから、カテゴリーの手がかり、サブカテゴリーのメンバーシップ、そして知覚された典型性へと焦点を移すことによって、差異を分解するよう研究者に促すものである。

----Content----
ハナンら（2019:2）は、「今日、社会学の中のいくつかの中心的な下位分野は、特定の概念-ジェンダー、人種、社会階級、職業-に焦点を当てることによって定義されている」と述べている。しかし、概念がより一般的にどのように作用し、共通の性質やプロセスに関与しているかについては、あまり注意が払われていない。これは、すべての社会的相互作用におけ る概念と分類の中心性を考えれば驚くべきことである。

このように、国家のカテゴリーは不平等を生み出す中心的なものである。エスノレイシャルとジェンダーの不平等の研究に対する支配的なアプローチ、私が不平等の標準モデル（SMI）と呼ぶものが、人種・民族とジェンダーという国家のカテゴリーが、無数の領域にわたる様々な不平等とどのように関連しているかを分析することにかかっているのは不思議なことではありません。

実際、私たちは国家の影で進行していることを明らかにするよう努めなければならない。このモデルは、カテゴリの表面 の下を見るという分析上の焦点を示すために、不平等のインフラカテゴリモデル（ICMI）と呼んでいます。ICMIは、（1）分析レンズを（名目）カテゴリのメンバーシップから、カテゴリ、サブカテゴリ、知覚された典型性の手がかりにシフトすることによって差異を分解する、（2）不平等における身体の役割を中心に据える（例：「不平等における身体」）ことによって、概念、カテゴリ、カテゴリの現代理論に我々の研究をより近づけることを目的としている。2）不平等における身体の役割を中心に据える（例：概念的レンズとして身体資本を用いる；Monk, Esposito, and Lee 2021を参照）。(3）集団内不平等の分析を集団間不平等とより対等な立場に引き上げる（Xie, Killewald, and Near 2016参照）；および（4）政治的な重要性を欠き、必ずしも集団を参照しない傾向にある、作動するが隠されている社会像と分裂の原則に分析上の注意を向けること。Brekhus（1998）が示唆するように、私たちは、マークされたものからマークされていないもの、あるいは疑われるものへと分析的な焦点を移す必要がある。

SMIで最もよく使われる分析のカテゴリーは、通常、社会的に非常に目につきやすく、政治的に顕著であり、国勢調査や官僚の書式、政治的言説、社会運動やメディアで使われるカテゴリーと一致するものである。

国家のカテゴリーもまた、本質的に還元主義的である。「連続体が存在するすべてのケースにおいて、法的な分類法や区分は、下／上、男性／女性という明確な線を引いている。

年齢を考えてみよう。AARP（米国退職者協会）のような組織は、メンバーシップを決定するために年齢制限を設けており、基本的に連続的なものを、50歳以上かそうでないかという二項対立に還元している。経過時間の連続的な差は、文化的に恣意的な不連続性に変換され、それが社会政治的に重要なものとして正統化され公式に認められ、実際の物質的影響（例えば、法定退職年齢、年金、課税、メディケアへのアクセス、社会保障給付など）と結びつけられるのである。これが、国家のカテゴリーを分析するSMIが、不平等を明らかにする一つの理由である。

これらの「繊維」は、カテゴリの手がかりとして機能する特性である。ロッシュは、同じ上位カテゴリーのメンバーが持つ繊維が多種多様であることを説明した。

しかし、概念、カテゴリー、分類に関する古典的な理論への固執を十分に捨てきれないまま、SMIの採用は、多くの学者にとって、ほとんど吟味されていない方法論の便宜を、社会世界の定型化されたバージョン-an-に変えてしまっているのである。

社会的現実の暗黙のビジョンそのものである（「一般的な線形現実」に関するアボット［1988］の指摘を参照）。SMIの社会的世界のヴィジョンは、分析のカテゴリーとして名目的な状態カテゴリーを用いることに根ざしており、カテゴリーのメンバーがすべてその典型性に違いがあるにもかかわらず、カテゴリーのすべてのメンバーを等しく「典型的」なものとして扱っている。

また、インターセクションの重要な介入は、人種／民族、ジェンダー、階級といった様々な上位カテゴリの複雑な連結を強調することによって、不平等が単に特定の上位社会カテゴリに属するという問題ではないことを強調し、その結果、固有の社会的ポジションをもたらす（Collins 2002; Crenshaw 1991）。しかしながら、社会的不平等に関する従来の説明には必要な複雑さが加わっているにもかかわらず、交差性はアリストテレスの名目主義の網にかかったままで、典型性については本質的に沈黙している。 

