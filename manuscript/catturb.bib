@article{Sullivan.2010, 
year = {2010}, 
keywords = {skill,skill transfer,occupational specific human capital,human capital,occupation,industry-occupation,industry}, 
title = {{Empirical evidence on occupation and industry specific human capital}}, 
author = {Sullivan, Paul}, 
journal = {Labour Economics}, 
issn = {0927-5371}, 
doi = {10.1016/j.labeco.2009.11.003}, 
pmid = {20526448}, 
pmcid = {PMC2879094}, 
abstract = {{This paper presents instrumental variables estimates of the effects of firm tenure, occupation specific work experience, industry specific work experience, and general work experience on wages using data from the 1979 Cohort of the National Longitudinal Survey of Youth. The estimates indicate that both occupation and industry specific human capital are key determinants of wages, and the importance of various types of human capital varies widely across one-digit occupations. Human capital is primarily occupation specific in occupations such as craftsmen, where workers realize a 14\% increase in wages after five years of occupation specific experience but do not realize wage gains from industry specific experience. In contrast, human capital is primarily industry specific in other occupations such as managerial employment where workers realize a 23\% wage increase after five years of industry specific work experience. In other occupations, such as professional employment, both occupation and industry specific human capital are key determinants of wages.}}, 
pages = {567--580}, 
number = {3}, 
volume = {17}, 
note = {----Title---- 職業・産業別人的資本に関する実証的証拠

----Abstract----
本論文では、1979年のNational Longitudinal Survey of Youthのデータを用いて、企業の勤続年数、職業別労働経験、産業別労働経験、一般労働経験が賃金に及ぼす影響について道具変数による推定値を示している。その結果、職業別・産業別の人的資本が賃金の主要な決定要因であり、一桁の職業によって人的資本の重要性が大きく異なることが示された。職人のような職業では、人的資本は主に職業固有のものであり、労働者は職業固有の経験を5年積むと14％の賃金上昇を実現するが、産業固有の経験による賃金上昇を実現することはない。一方、管理職のような他の職業では、人的資本は主に産業特有であり、労働者は産業特有な労働経験を5年積むと23％の賃金上昇を実現する。専門職のような他の職業では、職業特有と産業特有両方の人的資本が賃金の主要な決定要因である。

----Content----
職業内移動を除外した場合、Kambourov and Manovskii (2009a)の「人的資本は主に職業特化型である」という推計に合致している。

賃金上昇の要因が、企業、職業、産業に特化したスキルの蓄積によるものなのか、それとも完全に一般的ですべての職業間で伝達可能なスキルなのかは、賃金決定プロセスに関する基本的な疑問である。さらに、人的資本が職業と産業の両方に特化したものであるという発見は、現在の研究の多くの分野に示唆を与えている。

職業別賃金回帰の解釈の1つとして、職業間の異なるタイプの人的資本の特質に関する情報を提供していることがあげられる。

人的資本の蓄積過程における重要な特徴は、職業経験、産業経験、一般職務経験の価値が職業間で大きく異なることである。

