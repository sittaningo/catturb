@article{Weisshaar.2024, 
year = {2024}, 
keywords = {diversity,tech company,firm,organization,discrimination on hiring,hiring}, 
title = {{Hiring Discrimination Under Pressures to Diversify: Gender, Race, and Diversity Commodification across Job Transitions in Software Engineering}}, 
author = {Weisshaar, Katherine and Chavez, Koji and Hutt, Tania}, 
journal = {American Sociological Review}, 
issn = {0003-1224}, 
doi = {10.1177/00031224241245706}, 
abstract = {{White, male-dominated professions in the United States are marked with substantial gender and racial inequality in career advancement, yet they often face pressures to increase diversity. In these contexts, are theories of employer biases based on gender and racial stereotypes sufficient to explain patterns of hiring discrimination during common career transitions in the external labor market? If not, how and why do discrimination patterns deviate from predictions? Through a case study of software engineering, we first draw from a large-scale audit study and demonstrate unexpected patterns of hiring screening discrimination: while employers discriminate in favor of White men among early-career job applicants seeking lateral positions, for both early-career and senior workers applying to senior jobs, Black men and Black women face no discrimination compared to White men, and White women are preferred. Drawing on in-depth interviews, we explain these patterns of discrimination by demonstrating how decision-makers incorporate diversity value—applicants’ perceived worth for their contribution to organizational diversity—into hiring screening decisions, alongside biases. We introduce diversity commodification as the market-based valuative process by which diversity value varies across job level and intersectional groups. This article offers important implications for our understanding of gender, race, and employer decision-making in modern U.S. organizations.}}, 
pages = {584--613}, 
number = {3}, 
volume = {89}, 
note = {----Title---- 多様化圧力下での雇用差別：ソフトウェア・エンジニアリングにおける職務の変遷を通じたジェンダー、人種、多様性の商品化

----Abstract----
米国の白人男性優位の職業は、キャリアアップにおけるジェンダーや人種の不平等が顕著である。このような状況において、ジェンダーや人種のステレオタイプに基づく雇用者の偏見に関する理論は、外部労働市場における一般的なキャリア転換における雇用差別のパターンを説明するのに十分なのだろうか？もしそうでないとすれば、差別のパターンはどのように、そしてなぜ予測から外れるのだろうか？ソフトウェア・エンジニアリングの事例研究を通じて、我々はまず大規模な監査研究から、採用選考差別の予期せぬパターンを実証する。すなわち、雇用主は横並びのポジションを求める早期キャリアの求職者では白人男性を優遇する一方で、上級職の求人に応募する早期キャリアと上級職のいずれにおいても、黒人男性と黒人女性は白人男性に比べて差別を受けず、白人女性が優遇されるのである。このような差別のパターンを、詳細なインタビューに基づき、意思決定者がどのように多様性の価値（応募者が組織の多様性に貢献すると認識する価値）をバイアスとともに採用選考の意思決定に組み込んでいるかを明らかにすることで説明する。ダイバーシティの商品化とは、ダイバーシティの価値が職務レベルや交差するグループによって異なる、市場に基づく価値評価プロセスであることを紹介する。この論文は、現代の米国組織におけるジェンダー、人種、雇用者の意思決定についての理解に重要な示唆を与える。

----Content----
既存の研究は、公式な組織的多様性努力の有効性（例えば、Castilla 2015; Dobbin and Kalev 2022; Kalev, Dobbin, and Kelly 2006）や企業の多様性イデオロギーの性質（例えば、Embrick 2011; Leong 2013; Mayorga-Gallo 2019）について、重要な理論的・実証的洞察を提供しているが、多様性の圧力が、どのように、どの程度、誰に対して、採用における差別的意思決定を修正するのか（修正するとすれば）については曖昧である。この理論的曖昧さは、適切かつ決定的な実証的証拠の欠如と相まっている。

-

我々はまず、大規模な通信監査調査（N=11,190）を用いて、雇用主による黒人男性、黒人女性、転職を希望する白人女性に対する採用選考の決定における差別のパターンを、白人男性と比較して評価することにより、社会心理学的バイアス理論からの予測について明確な実証的検証を行う。その結果、ステレオタイプに基づくバイアスの予測とは一致しない予期せぬ差別のパターンを発見した。

-

2つ目の実証研究では、意思決定者とのインタビューによる質的分析を通じて、定量的知見に必要な解釈を与える（Small 2011）。そうすることで、このような予期せぬ差別パターンがどのように、そしてなぜ起こるのかを説明する、新しい組織プロセスを概念化する。

-

第一に、多様化を求める強い圧力の下にある白人男性優位の職業という文脈では、従来のステレオタイプに基づくバイアス理論では、転職をまたがる採用選考におけるジェンダー差別や人種差別のパターンを十分に説明できないことを示す。

-

採用決定者62名との綿密な半構造化インタビューから、決定者が(a)「多様性」を概念化し、多様性に関連する求職者を特定しようとする、(b)求職者の多様性価値を評価する、(c)求職者の多様性価値を固定観念的バイアスとともに採用選考の決定に組み込む、という新しい組織プロセスを説明する。私たちはこの価値評価プロセスをダイバーシティ商品化と呼んでいる。これは、交換を通じて個人のアイデンティティから価値を引き出すことは、それを商品化することであるという批判的ダイバーシティ研究の考え方に沿ったものである（Leong 2013:2183; Berrey 2015; Embrick 2011; Mayorga-Gallo 2019も参照）。

-

第二に、多様性の商品化とは、意思決定者が求職者の多様性の価値を評価し、その価値を彼らが持つかもしれない他のバイアスと一緒に採用選考の意思決定に組み込む組織的プロセスであると紹介する。

-

最後に、女性や人種的マイノリティ労働者の排除が継続的な社会問題となっているソフトウェア・エンジニアリングにおける広範な採用差別のパターン（Neely et al.

-

ジュニア」と「シニア」という用語は、企業ヒエラルキー内の特定の年功レベルではなく、役職の相対的なヒエラルキーを示すために使用している。

-

予測2：黒人男性、黒人女性、白人女性に対する差別は、白人男性と比較して、ジュニアからシニアへの移行において、ジュニアからジュニアへの移行と比較して大きくなる。

-

予測1：黒人男性、黒人女性、白人女性は、ジュニアからジュニアへの異動において、白人男性に比べて差別を経験する。

-

しかし、驚くべきことに、雇用差別は直接測定されておらず、多様化の圧力下にある白人や男性が支配的な職業における上方転換と側方転換の間で比較されていない。そこでは、ジェンダーと人種のステレオタイプが明らかに強力であり、女性やマイノリティ化した人種集団が経験する敵対的で排除的な職場環境が続いていることからも明らかである（Melaku 2019; Portocarrero and Carter 2022a）。

-

これらの理論的洞察は、通常、雇用やその他の人事の決定には適用されないが、多様化への強い圧力に直面している職業的状況において、差別のパターンが組織的に減少する可能性があることを示唆している。これは、意思決定プロセスが偏見の影響を受けないからではなく、意思決定者が労働者のパフォーマンスに対する評価に偏見を持ち続ける可能性があるからである。

-

多様性の商品化プロセスの第一段階は、多様性の概念化である。最も一般的な意味では、意思決定者は組織の多様性を、典型的なソフトウェア・エンジニアのデフォルト・スキーマとはカテゴリー的に対照的な個人の数値的表現として概念化する（Acker 1990; Ray 2019; Luhr 2023も参照）。

-

多様性というカテゴライズは、女性であることや黒人であることを含む明確なアイデンティティを持つ個人を単一のカテゴリーに還元する。

-

ダイバーシティ商品化の第二段階はダイバーシティ評価であり、意思決定者は、組織のダイバーシティに対する彼らのアイデンティティの貢献度、つまり彼らのダイバーシティ価値について、応募者の価値を暗黙のうちに評価する。

-

回答者たちは、多様性の源泉として「女性」が好まれることを認識していたが、白人女性にとっての商品化がもたらす真の結果を直接認識したのは、少数派、すなわち人種的マイノリティ自身だけであった。

-

黒人の多様性は快適な規範のためのコストである。  意思決定者は、黒人代表を明確なコストと結びつける。黒人の代表性を高めること、とりわけ黒人の存在が際立つようになることは、本質的に白人の組織空間における居心地の良さの規範と対立する。

-

黒人の議論、擁護、認知は、しばしば「物議をかもす」、破壊的なものとして解釈される（Moore 2008; Thornhill 2015）。

-

黒人の多様性は多様性のイメージを損なう。  黒人の代表を増やそうという呼びかけは、黒人の代表が増えれば、多様性があり、現代的で、オープンマインドな職場という企業イメージが向上するどころか、むしろ損なわれてしまうのではないかという恐れを抱かせる。

-

私たちは、多様性の価値は採用選考の意思決定に組み込まれるものであり、したがって、多様性の価値のばらつきを考慮することは、監査研究で発見された差別のパターンを完全に説明するために必要であると主張する。しかし、既存の理論が監査調査の結果に対する代替説明を提供しているかどうかも考慮しなければならない。我々は、これらの代替説明がこのような環境における差別と無関係であると主張するのではなく、むしろ、意思決定における多様性の価値も考慮しなければ、差別パターンを完全に説明できないと主張するのである。

-

第一に、上級職に応募した白人女性、黒人男性、黒人女性の応募者が、疎外された集団の他の応募者と比べて「例外的」であると認識された可能性がある（上昇志向が強かったり、すでに上級職に就いていたりしたため）。I

-

第二に、監査調査の結果が、ソフトウェア・エンジニアリングの上級職が、早期職と比較して、女性や黒人労働者のステレオタイプに適合したスキルや能力と、より密接に関連している結果であるかどうか疑問に思うかもしれない。

-

従来のステレオタイプ・バイアス理論の予測に沿い、我々は、早期の黒人女性、黒人男性、および白人女性の応募者が、早期のキャリア・ポジションへの側方移行を希望しているのに対して、白人男性が有利であるという差別の証拠を発見した。しかし、予測とは対照的に、黒人男性や黒人女性が中堅職に応募する場合には、応募者自身が早期キャリアであるか中堅職であるかにかかわらず、黒人男性や黒人女性に対する差別、白人女性に対する選好の証拠は見つからない。この予想外の結果を理解するために、採用決定者とのインタビューの質的分析を行った。

-

第二に、採用選考における性差別や人種差別を減らすことができる新しい組織プロセスを明らかにすることで、ダイバーシティ商品化は、企業のダイバーシティへの取り組みに関する文献だけでなく、そうした取り組みに批判的な研究にも貢献する。

-

本研究は3つの主要な貢献をしている。

-

第一に、従来のバイアス理論に立脚し、これらの理論は採用時点での雇用者の意思決定に重要な洞察を与えるものの、ダイバーシティの強い圧力の下での白人や男性優位の職種における差別のパターンを完全には説明できないことを示す。多様性の商品化の下では、採用差別の結果は応募者の多様性の価値だけでなく、ステレオタイプに基づくバイアスの関数である。

-

さらに、ダイバーシティ商品化は、ダイバーシティ・イデオロギーに関する批判的研究（Bell and Hartmann 2007; Douds 2021; Embrick 2011; Hirschman and Garbes 2021; Leong 2013; Mayorga-Gallo 2019; Warikoo 2016）を基礎としている。

-

我々の最後の主要な貢献は、外部労働市場におけるソフトウェア・エンジニアリングの転職におけるジェンダー差別と人種差別のパターンを直接実証的に測定したことである。

-

皮肉なことに、キャリアの初期段階にある労働者の多様性が相対的に高いことが、多様性に関連する個々の労働者がその段階で多様性の価値が低く、より多くの差別を経験する理由の一つであることがわかった。さらに、インタビューの最後に、黒人女性の採用選考結果には何のメリットもないという我々の新たな監査研究結果について話したとき、回答者の多くは完全にショックを受けた。

-

不平等の研究者たちは、社会学的研究が不平等な結 果を説明するために主に排除のプロセスに焦点を当ててい る一方で、包摂の力は今日私たちが目にしている不平等の パターンに非常に大きな影響を及ぼしていることを強調し てきた（McMillan Cottom 2020）。しかし、包摂はしばしば不均等であり、限定的であ り、「略奪的」ですらある（Seamster and Charron-Chénier 2017）。

