{
  "name": "catturb",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "rstudio",
  "workspaceFolder": "/home/rstudio/work",
  "remoteUser": "rstudio",
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "reditorsupport.r",
        "ms-python.python"
      ]
    }
  },
  "forwardPorts": [8787],
  "postStartCommand": "echo 'Container ready'"
}